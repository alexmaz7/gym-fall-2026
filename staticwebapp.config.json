{
  "platform": {
    "apiRuntime": "node:22"
  },
  "routes": [
    { "route": "/manifest.webmanifest", "allowedRoles": ["anonymous"] },
    { "route": "/icons/*", "allowedRoles": ["anonymous"] },
    { "route": "/api/*", "allowedRoles": ["owner"] },
    { "route": "/*", "allowedRoles": ["owner"] }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/github?post_login_redirect_uri=.referrer",
      "statusCode": 302
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/icons/*", "/api/*"]
  }
}
